# Copy to `.env` (untracked). Read by build.rs (EXPAD_*) and by the Vite build in web/ (VITE_*, EXPAD_*).

# Required: WPA2 password (8-63 printable ASCII characters) of the device's WiFi access point.
EXPAD_WIFI_PASSWORD=

# PrimeUI license key (https://primeui.dev/licenses/community). Without it the web interface shows a license notice.
VITE_PRIMEUI_LICENSE=

# Device address the `npm run dev` server proxies the web interface WebSocket to.
# Ignored by `npm run dev:mock`, which proxies to the mock device instead.
EXPAD_DEVICE_ADDRESS=192.168.4.1
