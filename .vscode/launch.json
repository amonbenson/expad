{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "binName",
      "type": "pickString",
      "description": "Program to build/run (src/bin/*.rs)",
      "options": ["capture", "detect_pin_mapping", "rainbow", "potentiometer", "midi_loopback", "web_interface", "expression_controller", "adc_characterization"],
      "default": "capture"
    }
  ],
  "configurations": [
    {
      "name": "Debug Pico 2 (probe-rs)",
      "type": "probe-rs-debug",
      "request": "launch",
      "preLaunchTask": "${defaultBuildTask}",
      "cwd": "${workspaceFolder}",
      "chip": "RP235x",
      "speed": 10000,
      "flashingConfig": {
        "flashingEnabled": true,
        "haltAfterReset": false
      },
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "${workspaceFolder}/target/thumbv8m.main-none-eabihf/debug/${input:binName}",
          "rttEnabled": true,
          "rttChannelFormats": [
            {
              "channelNumber": 0,
              "dataFormat": "Defmt",
              "showLocation": true
            }
          ]
        }
      ],
      "consoleLogLevel": "Info"
    }
  ]
}
